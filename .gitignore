*.xcscmblueprint
*.xccheckout

# Xcode - workspace cruft
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.xcworkspace/xcuserdata/

# Swift Package Manager
# NOTE: Package.resolved is intentionally NOT ignored — it pins dependency
# versions and should be committed.
.swiftpm/
.build/

# Playgrounds
timeline.xctimeline
playground.xcworkspace
