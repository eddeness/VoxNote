# macOS
.DS_Store

# Environment variables (commit only placeholder examples)
.env
.env.*
!.env.example
!.env.*.example

# Credentials and signing material
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.mobileprovision
